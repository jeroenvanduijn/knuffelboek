# ==============================================
# KNUFFELBOEK - Environment Variables voor Deployment
# ==============================================
# Kopieer dit bestand naar .env en vul de waardes in

# ------------------------------------
# Google Cloud (verplicht voor AI)
# ------------------------------------
GOOGLE_CLOUD_PROJECT=knuffelboek-app

# Service account JSON key - base64 encoded voor deployment
# Lokaal: pad naar JSON bestand
# Railway: base64 encoded string van de JSON key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Of voor Railway:
# GOOGLE_APPLICATION_CREDENTIALS_BASE64=base64-encoded-json-here

# ------------------------------------
# Stripe Payments (verplicht)
# ------------------------------------
# Test keys (begin met pk_test_ en sk_test_)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx

# Live keys (begin met pk_live_ en sk_live_) - voor productie
# STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxx

# Webhook secret (krijg je van Stripe Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ------------------------------------
# Lulu Print-on-Demand (verplicht)
# ------------------------------------
LULU_API_KEY=your-lulu-api-key
LULU_API_SECRET=your-lulu-api-secret
LULU_TEST_MODE=false

# Lulu Product SKUs
LULU_SKU_SQUARE_HARDCOVER=0850X0850FCPRECW060UW444MXX
LULU_SKU_SQUARE_SOFTCOVER=0850X0850FCPREPB060UW444MXX

# ------------------------------------
# Pricing (in euro cents)
# ------------------------------------
HARDCOVER_PRICE_CENTS=3995
SOFTCOVER_PRICE_CENTS=2995

# Admin test pricing
ADMIN_TEST_PRICE_CENTS=50
ADMIN_TEST_EMAILS=jeroen@crossfitleiden.com

# ------------------------------------
# App Configuration
# ------------------------------------
# De publieke URL van je app (voor email links en redirects)
BASE_URL=https://app.knuffelboek.nl

# ------------------------------------
# Email Notifications (optioneel)
# ------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@knuffelboek.nl
SMTP_FROM_NAME=Knuffelboek

# ------------------------------------
# Peecho (legacy - niet meer in gebruik)
# ------------------------------------
# PEECHO_API_KEY=
# PEECHO_API_SECRET=
# PEECHO_TEST_MODE=true
# PEECHO_PRODUCT_ID=
